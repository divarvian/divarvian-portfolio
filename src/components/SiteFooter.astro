---
import { ui, type Lang } from "../i18n/ui";
import { prefixFor } from "../i18n/ui";
interface Props { lang?: Lang }
const lang = Astro.props.lang ?? 'id';
const t = ui[lang].footer;
const p = prefixFor(lang);
---
<footer class="site-foot">
  <div class="wrap foot-top">
    <div class="foot-brand-col">
      <p class="foot-brand">divarvian.my.id</p>
      <p class="foot-note">{t.note}</p>
      <div class="foot-social">
        <a href="https://github.com/divarvian" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0.3a12 12 0 0 0-3.79 23.4c0.6 0.11 0.82-0.26 0.82-0.58v-2.1c-3.34 0.73-4.04-1.61-4.04-1.61-0.55-1.39-1.34-1.76-1.34-1.76-1.09-0.75 0.08-0.73 0.08-0.73 1.2 0.08 1.83 1.23 1.83 1.23 1.07 1.84 2.81 1.31 3.5 1 0.11-0.78 0.42-1.31 0.76-1.61-2.67-0.3-5.48-1.34-5.48-5.95 0-1.31 0.47-2.38 1.24-3.22-0.12-0.3-0.54-1.52 0.12-3.17 0 0 1.01-0.32 3.3 1.23a11.5 11.5 0 0 1 6.0 0c2.29-1.55 3.3-1.23 3.3-1.23 0.66 1.65 0.24 2.87 0.12 3.17 0.77 0.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.65-5.49 5.95 0.43 0.37 0.81 1.1 0.81 2.22v3.29c0 0.32 0.22 0.69 0.82 0.58A12 12 0 0 0 12 0.3Z"/></svg></a>
        <a href="https://linkedin.com/in/divarvian" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg></a>
        <a href="https://instagram.com/divarvian" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
        <a href="mailto:divarvian@gmail.com" aria-label="Email"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></a>
      </div>
    </div>
    <nav class="foot-nav" aria-label="Footer navigation">
      <div>
        <p class="foot-nav-title">{t.pages}</p>
        <a href={`${p}/#work`}>{t.pages === 'Halaman' ? 'Project' : 'Work'}</a>
        <a href={`${p}/#stack`}>{t.pages === 'Halaman' ? 'Teknologi' : 'Stack'}</a>
        <a href={`${p}/#about`}>{t.pages === 'Halaman' ? 'Tentang' : 'About'}</a>
        <a href={`${p}/#contact`}>{t.pages === 'Halaman' ? 'Kontak' : 'Contact'}</a>
      </div>
      <div>
        <p class="foot-nav-title">{t.links}</p>
        <a href="https://github.com/divarvian" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/divarvian" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://instagram.com/divarvian" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="mailto:divarvian@gmail.com">Email</a>
      </div>
    </nav>
  </div>
  <div class="wrap foot-bottom">
    <p>{t.copyright}</p>
    <p>{t.built} <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></p>
  </div>
</footer>
