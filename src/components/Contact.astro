---
import { ui, type Lang } from "../i18n/ui";
interface Props { lang?: Lang }
const lang = Astro.props.lang ?? 'id';
const t = ui[lang].contact;
---
<section id="contact" class="section wrap contact reveal" data-delay="1">
  <div class="contact-card win win-dark">
    <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">contact — arvian@fedora: ~</span><span class="win-spacer"></span></div>
    <div class="win-body">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p>{t.desc}</p>
    </div>
    <div class="contact-actions">
      <a class="btn btn-primary" href="mailto:divarvian@gmail.com">divarvian@gmail.com</a>
      <button class="btn btn-ghost" id="copyEmail" type="button">{t.copyEmail}</button>
      <button class="btn btn-ghost cv-btn" id="downloadCV" type="button" data-cv-label={t.downloadCV} data-cv-loading={t.generatingCV} data-cv-file={t.cvFileName} data-cv-lang={lang} aria-label={t.downloadCV}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13"/><path d="m7 10 5 5 5-5"/><path d="M3 17v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2"/></svg>
        <span class="cv-label">{t.downloadCV}</span>
        <span class="cv-sub">PDF • ATS</span>
      </button>
      <span class="copy-status" id="copyStatus" role="status" aria-live="polite"></span>
    </div>
    <div class="social-row">
      <a href="https://github.com/divarvian" target="_blank" rel="noopener noreferrer" aria-label="GitHub divarvian">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0.3a12 12 0 0 0-3.79 23.4c0.6 0.11 0.82-0.26 0.82-0.58v-2.1c-3.34 0.73-4.04-1.61-4.04-1.61-0.55-1.39-1.34-1.76-1.34-1.76-1.09-0.75 0.08-0.73 0.08-0.73 1.2 0.08 1.83 1.23 1.83 1.23 1.07 1.84 2.81 1.31 3.5 1 0.11-0.78 0.42-1.31 0.76-1.61-2.67-0.3-5.48-1.34-5.48-5.95 0-1.31 0.47-2.38 1.24-3.22-0.12-0.3-0.54-1.52 0.12-3.17 0 0 1.01-0.32 3.3 1.23a11.5 11.5 0 0 1 6.0 0c2.29-1.55 3.3-1.23 3.3-1.23 0.66 1.65 0.24 2.87 0.12 3.17 0.77 0.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.65-5.49 5.95 0.43 0.37 0.81 1.1 0.81 2.22v3.29c0 0.32 0.22 0.69 0.82 0.58A12 12 0 0 0 12 0.3Z"/></svg>
        <span>github.com/divarvian</span>
      </a>
      <a href="https://linkedin.com/in/divarvian" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn divarvian">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-0.48-2.24-1.67-2.24-0.91 0-1.45 0.61-1.69 1.2-0.09 0.21-0.11 0.51-0.11 0.81v5.8H9.86s0.05-9.41 0-10.39h3.56v1.47c0.47-0.73 1.32-1.77 3.22-1.77 2.35 0 4.11 1.54 4.11 4.84v5.85ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm1.78 13.02H3.56V10.06h3.56v10.39Z"/><path d="M0 0h24v24H0z" fill="none"/></svg>
        <span>linkedin.com/in/divarvian</span>
      </a>

    </div>
    </div>
  </div>
</section>
<style>
  .cv-btn{gap:7px}
  .cv-btn .cv-sub{font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:0.06em;opacity:0.72;font-weight:500}
  .cv-btn:disabled{opacity:0.6;pointer-events:none}
</style>
<script>
  (function(){
    var btn = document.getElementById('downloadCV');
    if(!btn) return;
    var labelEl = btn.querySelector('.cv-label');
    var orig = btn.getAttribute('data-cv-label') || 'Unduh CV';
    var loading = btn.getAttribute('data-cv-loading') || 'Menyiapkan CV...';
    function loadJsPDF(){
      if(window.jspdf && window.jspdf.jsPDF) return Promise.resolve();
      return new Promise(function(res, rej){
        var s = document.createElement('script');
        s.src = '/jspdf.min.js';
        s.onload = function(){ res(); };
        s.onerror = rej;
        document.head.appendChild(s);
      });
    }
    function generateCV(lang){
      var jsPDF = window.jspdf && window.jspdf.jsPDF ? window.jspdf.jsPDF : null;
      if(!jsPDF) throw new Error('jspdf not loaded');
      var isEn = lang === 'en';
      var doc = new jsPDF({ unit: 'mm', format: 'a4' });
      var W = 210, H = 297, M = 15, usable = W - M*2;
      var y = 12;
      function ensure(h){ if(y + h > H - 12){ doc.addPage(); y = 12; } }
      function textBlock(txt, size, style, color, gap){
        doc.setFont('helvetica', style);
        doc.setFontSize(size);
        doc.setTextColor(color[0], color[1], color[2]);
        var lines = doc.splitTextToSize(txt, usable);
        ensure(lines.length * gap + 1);
        doc.text(lines, M, y);
        y += lines.length * gap + (style === 'bold' ? 0.5 : 0);
      }
      function section(title){
        ensure(10);
        y += 2.5;
        doc.setDrawColor(194,65,12);
        doc.setLineWidth(0.45);
        doc.line(M, y, W - M, y);
        y += 4;
        doc.setFont('helvetica','bold'); doc.setFontSize(7);
        doc.setTextColor(194,65,12);
        doc.text(title.toUpperCase(), M, y);
        y += 4.2;
        doc.setDrawColor(232,228,221);
        doc.setLineWidth(0.22);
        doc.line(M, y, W - M, y);
        y += 4;
      }
      function item(title, sub, date, bullets){
        doc.setFont('helvetica','bold'); doc.setFontSize(9);
        doc.setTextColor(20,24,30);
        var dateW = doc.getTextWidth(date) + 4;
        var titleLines = doc.splitTextToSize(title, usable - dateW);
        ensure(titleLines.length * 4 + 8);
        doc.text(titleLines, M, y);
        doc.setFont('helvetica','normal'); doc.setFontSize(7.5);
        doc.setTextColor(94,92,88);
        doc.text(date, W - M - doc.getTextWidth(date), y);
        y += titleLines.length * 4 + 0.6;
        if(sub){
          doc.setFont('helvetica','italic'); doc.setFontSize(7.5);
          doc.setTextColor(94,92,88);
          var subLines = doc.splitTextToSize(sub, usable);
          ensure(subLines.length * 3.2 + 1);
          doc.text(subLines, M, y);
          y += subLines.length * 3.2 + 1;
        }
        doc.setFont('helvetica','normal'); doc.setFontSize(7.5);
        doc.setTextColor(43,50,59);
        bullets.forEach(function(b){
          var bul = '  ' + b;
          var lines = doc.splitTextToSize(bul, usable - 3);
          ensure(lines.length * 3.2 + 0.5);
          doc.text(lines, M + 2, y);
          y += lines.length * 3.2 + 0.5;
        });
        y += 1.5;
      }
      var profileTitle = isEn ? 'PROFILE' : 'PROFIL';
      var expTitle = isEn ? 'EXPERIENCE' : 'PENGALAMAN';
      var eduTitle = isEn ? 'EDUCATION' : 'PENDIDIKAN';
      var stackTitle = isEn ? 'TECH STACK' : 'TEKNOLOGI';
      var langTitle = isEn ? 'LANGUAGES' : 'BAHASA';
      var contactTitle = isEn ? 'CONTACT' : 'KONTAK';
      doc.setFont('helvetica','bold'); doc.setFontSize(20);
      doc.setTextColor(20,24,30);
      doc.text('DIVA ARVIANSYAH', M, y); y += 5.2;
      doc.setFont('helvetica','normal'); doc.setFontSize(9);
      doc.setTextColor(194,65,12);
      doc.text('Mobile Engineer', M, y); y += 3.2;
      doc.setFont('helvetica','normal'); doc.setFontSize(7.2);
      doc.setTextColor(94,92,88);
      doc.text('Malang, Indonesia  |  divarvian@gmail.com  |  github.com/divarvian  |  linkedin.com/in/divarvian  |  divarvian.my.id', M, y);
      y += 2.8;
      doc.setDrawColor(232,228,221); doc.setLineWidth(0.3);
      doc.line(M, y, W - M, y); y += 4;
      section(profileTitle);
      textBlock(
        isEn
          ? 'Mobile Engineer and Information Technology Education student at FILKOM UB, active in Raion Community. Daily work with Kotlin and Jetpack Compose and Flutter, with focus on polished UI, type safe navigation, and modular architecture. Comfortable working with PM and UI/UX in small teams.'
          : 'Mobile Engineer dan mahasiswa Pendidikan Teknologi Informasi FILKOM UB, aktif di Raion Community. Sehari hari menggunakan Kotlin dengan Jetpack Compose dan Flutter, fokus pada UI yang rapi, navigasi type safe, dan arsitektur modular. Nyaman bekerja bersama PM dan UI/UX dalam tim kecil.',
        7.5, 'normal', [43,50,59], 3.25
      );
      section(expTitle);
      item(
        'Raion Community - Mobile Engineer',
        'Flutter, Dart  |  ' + (isEn ? 'Kawal.Z, Raion Hackjam 2026 - Best Implementation' : 'Kawal.Z, Raion Hackjam 2026 - Best Implementation'),
        'Mar 2026 - ' + (isEn ? 'Present' : 'Sekarang'),
        isEn ? [
          'Built Kawal.Z, an app helping Indonesian Gen Z understand and track public policy with AI TLDR summaries, gamification, interactive voting, and leaderboard for 4 issue categories.',
          'Translated UI/UX design into a demo ready Flutter app within one week from idea to implementation with PM and UI/UX.',
          'Collaborated in a cross functional team with fast iteration and daily sync.'
        ] : [
          'Membangun Kawal.Z, aplikasi untuk Gen Z memahami dan mengawal kebijakan publik dengan ringkasan AI TLDR, gamifikasi, voting interaktif, dan leaderboard untuk 4 kategori isu.',
          'Menerjemahkan desain UI/UX menjadi aplikasi Flutter siap demo dalam satu minggu dari ide hingga implementasi bersama PM dan UI/UX.',
          'Berkolaborasi dalam tim lintas peran dengan ritme cepat dan sinkronisasi harian.'
        ]
      );
      item(
        'Raion Community - Intern Mobile Engineer',
        'Kotlin, Android Development  |  ' + (isEn ? 'BinGo, Raion Intern - Final Pitching' : 'BinGo, Raion Intern - Final Pitching'),
        'Mar 2026',
        isEn ? [
          'Built BinGo, a gamified environmental education app for elementary school children with Gobi dinosaur mascot to learn waste sorting, daily missions, environmental stories, and quizzes.',
          'Implemented gamification with XP, coins, and levels plus type safe navigation with Jetpack Compose alongside another Mobile Engineer.',
          'Maintained a modular project structure and presented the final pitching to the Raion team.'
        ] : [
          'Membangun BinGo, aplikasi edukasi lingkungan berbasis gamifikasi untuk anak Sekolah Dasar bersama maskot dinosaurus Gobi untuk belajar memilah sampah, misi harian, cerita lingkungan, dan kuis.',
          'Menerapkan gamifikasi XP, koin, dan level serta navigasi type safe dengan Jetpack Compose bersama satu Mobile Engineer lain.',
          'Menjaga struktur project yang modular dan mempresentasikan final pitching di hadapan tim Raion.'
        ]
      );
      item(
        isEn ? 'Laboratory Assistant: Basic Programming - FILKOM UB' : 'Asisten Laboratorium: Pemrograman Dasar - FILKOM UB',
        isEn ? 'On-site, Malang  |  PTI Class of 2025 Class A practicum' : 'On-site, Malang  |  Praktikum PTI Angkatan 2025 Kelas A',
        isEn ? 'Sep 2025 - Dec 2025' : 'Sep 2025 - Des 2025',
        isEn ? [
          'Assisted students in understanding programming fundamentals during practicum sessions.',
          'Guided assignments and explained core concepts in a productive atmosphere.'
        ] : [
          'Mendampingi mahasiswa memahami dasar pemrograman selama sesi praktikum.',
          'Membimbing pengerjaan tugas dan menjelaskan konsep inti.'
        ]
      );
      item(
        isEn ? 'Volunteer - Filkom Goes To School, FILKOM UB' : 'Volunteer - Filkom Goes To School, FILKOM UB',
        'Ponorogo  |  Seasonal',
        isEn ? 'Jul 2025 - Aug 2025' : 'Jul 2025 - Agu 2025',
        isEn ? [
          'Participated in outreach program in Ponorogo and practiced public speaking with students.'
        ] : [
          'Terlibat dalam program pengabdian di Ponorogo dan melatih public speaking bersama siswa.'
        ]
      );
      item(
        'Telkom Indonesia - Technical Intern',
        isEn ? 'On-site, Ponorogo  |  Fiber Optics' : 'On-site, Ponorogo  |  Fiber Optics',
        isEn ? 'Jan 2022 - May 2022' : 'Jan 2022 - Mei 2022',
        isEn ? [
          'Completed 5 month apprenticeship focused on fiber optic installation and network fundamentals.'
        ] : [
          'Menyelesaikan magang 5 bulan dengan fokus pada instalasi fiber optik dan dasar jaringan.'
        ]
      );
      section(eduTitle);
      item(
        isEn ? 'Universitas Brawijaya - Bachelor of Education, Information Technology Education' : 'Universitas Brawijaya - Sarjana Pendidikan, Pendidikan Teknologi Informasi',
        '',
        '2024 - 2028',
        []
      );
      item(
        isEn ? 'SMKN 1 Badegan - Computer and Network Engineering' : 'SMKN 1 Badegan - Teknik Komputer dan Jaringan',
        '',
        '2020 - 2023',
        []
      );
      section(stackTitle);
      var stacks = [
        'Kotlin, Jetpack Compose, Flutter, Dart, Java, C++',
        'JavaScript, Laravel, Go, Astro, Supabase',
        'MySQL, PostgreSQL, Git, Android Studio, VS Code, Figma',
        'Fedora Linux'
      ];
      doc.setFont('helvetica','normal'); doc.setFontSize(7.5);
      doc.setTextColor(43,50,59);
      stacks.forEach(function(s){
        var lines = doc.splitTextToSize('  ' + s, usable - 3);
        ensure(lines.length * 3.2 + 0.5);
        doc.text(lines, M + 2, y);
        y += lines.length * 3.2 + 0.5;
      });
      y += 1;
      section(langTitle);
      textBlock(isEn ? 'Indonesian: Native  |  English: Professional working proficiency' : 'Indonesia: Penutur asli  |  Inggris: Mahir profesional', 7.5, 'normal', [43,50,59], 3.2);
      section(contactTitle);
      var contacts = [
        'Email: divarvian@gmail.com',
        'GitHub: github.com/divarvian',
        'LinkedIn: linkedin.com/in/divarvian',
        'Website: divarvian.my.id',
        'Location: Malang, Indonesia'
      ];
      doc.setFont('helvetica','normal'); doc.setFontSize(7.5);
      doc.setTextColor(43,50,59);
      contacts.forEach(function(c){
        var lines = doc.splitTextToSize(c, usable);
        ensure(lines.length * 3.2 + 0.5);
        doc.text(lines, M, y);
        y += lines.length * 3.2 + 0.5;
      });
      var footY = H - 7;
      doc.setFillColor(253,252,248);
      doc.rect(0, H - 10, W, 10, 'F');
      doc.setFont('helvetica','normal'); doc.setFontSize(6.2);
      doc.setTextColor(140,138,135);
      doc.text('Generated from divarvian.my.id  |  ' + new Date().toISOString().slice(0,10), M, footY);
      return doc;
    }
    btn.addEventListener('click', function(){
      var lang = btn.getAttribute('data-cv-lang') || 'id';
      var file = btn.getAttribute('data-cv-file') || 'CV-Diva-Arviansyah.pdf';
      if(labelEl) labelEl.textContent = loading;
      btn.disabled = true;
      loadJsPDF().then(function(){
        try{
          var doc = generateCV(lang);
          doc.save(file);
          if(window.haptic) window.haptic(14);
          if(window.toast) window.toast(lang==='en' ? 'CV downloaded' : 'CV terunduh');
        }catch(e){
          if(window.toast) window.toast('Gagal membuat CV');
        }
        if(labelEl) labelEl.textContent = orig;
        btn.disabled = false;
      }).catch(function(){
        if(window.toast) window.toast('Gagal memuat generator CV');
        if(labelEl) labelEl.textContent = orig;
        btn.disabled = false;
      });
    });
  })();
</script>
