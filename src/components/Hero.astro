---
import { ui, type Lang } from "../i18n/ui";
interface Props { lang?: Lang }
const lang = Astro.props.lang ?? 'id';
const t = ui[lang].hero;
---
<section class="hero wrap reveal">
  <div class="hero-grid">
    <div class="hero-main">
      <div class="hero-identity">
        <div class="avatar" aria-hidden="true"><span>DA</span></div>
        <div class="hero-name">
          <h1 class="display">Diva Arviansyah</h1>
          <p class="hero-role">{t.role}</p>
        </div>
      </div>
      <p class="eyebrow hero-sub">{t.sub}</p>
      <p class="lead">{t.lead}</p>
      <div class="hero-badges">
        <div class="hero-status" role="status" aria-live="polite">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{t.openBadge}</span>
        </div>
        <div class="hero-email">
          <span class="hero-email-text">divarvian@gmail.com</span>
          <button type="button" class="copy-btn" data-copy-text="divarvian@gmail.com" aria-label={t.copyEmail} title={t.copyEmail}>
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/></svg>
            <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          </button>
        </div>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">{t.sayHi}</a>
        <a class="btn btn-ghost" href="#work">{t.viewWork}</a>
      </div>
      <div class="hero-meta">
        <div class="meta-item">
          <span class="meta-k">{t.metaLabels.location}</span>
          <span class="meta-v">{t.meta.location}</span>
        </div>
        <div class="meta-item">
          <span class="meta-k">{t.metaLabels.focus}</span>
          <span class="meta-v">{t.meta.focus}</span>
        </div>
        <div class="meta-item">
          <span class="meta-k">{t.metaLabels.domain}</span>
          <span class="meta-v">{t.meta.domain}</span>
        </div>
      </div>
    </div>
    <div class="hero-side">
      <div class="win side-card">
        <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">saat-ini.sh — arvian@fedora</span><span class="win-spacer"></span></div>
        <div class="win-body">
          <p class="card-label">{t.sideLabel}</p>
          <p class="card-title">{t.sideTitle}</p>
          <p class="card-text">{t.sideText}</p>
          <div class="side-divider" aria-hidden="true"></div>
          <ul class="side-list">
            {t.sideList.map((s) => <li><span>{s.k}</span><span>{s.v}</span></li>)}
          </ul>
          <a class="text-link" href="#work">{t.viewProject}</a>
        </div>
      </div>
      <div class="side-note">
        <span class="dot" aria-hidden="true"></span>
        <span>{t.sideNote}</span>
      </div>
    </div>
  </div>
</section>
