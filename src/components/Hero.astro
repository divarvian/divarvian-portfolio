---
---
<section class="hero wrap reveal">
  <div class="hero-grid">
    <div class="hero-main">
      <div class="hero-identity">
        <div class="avatar" aria-hidden="true"><span>DA</span></div>
        <div class="hero-name">
          <h1 class="display">Diva Arviansyah</h1>
          <p class="hero-role">Mobile Engineer</p>
        </div>
      </div>
      <p class="eyebrow hero-sub">PTI FILKOM UB · Raion Community</p>
      <p class="lead">Suka bikin antarmuka mobile yang rapi. Perhatiin detail, interaksi yang halus, dan UX yang nyaman. Sehari-hari pakai Kotlin dengan Jetpack Compose dan Flutter, lagi mendalami Java dan C++ biar paham sistem lebih dalam.</p>
      <div class="hero-badges">
        <div class="hero-status" role="status" aria-live="polite">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Terbuka untuk magang</span>
        </div>
        <div class="hero-email">
          <span class="hero-email-text">divarvian@gmail.com</span>
          <button type="button" class="copy-btn" data-copy-text="divarvian@gmail.com" aria-label="Salin email" title="Salin email">
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/></svg>
            <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          </button>
        </div>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">Say Hi!</a>
        <a class="btn btn-ghost" href="#work">Lihat karya</a>
      </div>
      <div class="hero-meta">
        <div class="meta-item">
          <span class="meta-k">Lokasi</span>
          <span class="meta-v">Malang, Indonesia</span>
        </div>
        <div class="meta-item">
          <span class="meta-k">Fokus</span>
          <span class="meta-v">Kotlin Compose, Flutter</span>
        </div>
        <div class="meta-item">
          <span class="meta-k">Domain</span>
          <span class="meta-v">divarvian.my.id</span>
        </div>
      </div>
    </div>
    <div class="hero-side">
      <div class="win side-card">
        <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">saat-ini.sh — arvian@fedora</span><span class="win-spacer"></span></div>
        <div class="win-body">
          <p class="card-label">Saat ini</p>
          <p class="card-title">Kuliah di Malang</p>
          <p class="card-text">Mahasiswa Pendidikan Teknologi Informasi, FILKOM UB, aktif di Raion Community sebagai Mobile Engineer.</p>
          <div class="side-divider" aria-hidden="true"></div>
          <ul class="side-list">
            <li><span>Prodi</span><span>PTI, FILKOM UB</span></li>
            <li><span>Peran</span><span>Mobile Engineer</span></li>
            <li><span>Kota</span><span>Malang</span></li>
          </ul>
          <a class="text-link" href="#work">Lihat project →</a>
        </div>
      </div>
      <div class="side-note">
        <span class="dot" aria-hidden="true"></span>
        <span>Terbuka untuk kolaborasi mobile.</span>
      </div>
    </div>
  </div>
</section>
