---
import { ui, type Lang } from "../i18n/ui";
interface Props { lang?: Lang }
const lang = Astro.props.lang ?? 'id';
const t = ui[lang].hero;
---
<section class="hero wrap reveal">
  <div class="hero-grid">
    <div class="hero-main">
      <div class="hero-identity">
        <div class="avatar" aria-hidden="true"><span>DA</span></div>
        <div class="hero-name">
          <h1 class="display">Diva Arviansyah</h1>
          <p class="hero-role"><span class="hero-typing" data-typing={t.role} aria-label={t.role}>{t.role}<span class="caret" aria-hidden="true"></span></span></p>
        </div>
      </div>
      <p class="eyebrow hero-sub">{t.sub}</p>
      <p class="lead">{t.lead}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">{t.sayHi}</a>
        <a class="btn btn-ghost" href="#work">{t.viewWork}</a>
      </div>
      <div class="hero-meta">
        <div class="meta-item">
          <span class="meta-k">{t.metaLabels.location}</span>
          <span class="meta-v">{t.meta.location}</span>
        </div>
        <div class="meta-item">
          <span class="meta-k">{t.metaLabels.focus}</span>
          <span class="meta-v">{t.meta.focus}</span>
        </div>
        <div class="meta-item">
          <span class="meta-k">{t.metaLabels.domain}</span>
          <span class="meta-v">{t.meta.domain}</span>
        </div>
      </div>
    </div>
    <div class="hero-side">
      <div class="win side-card">
        <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">saat-ini.sh — arvian@fedora</span><span class="win-spacer"></span></div>
        <div class="win-body">
          <p class="card-label">{t.sideLabel}</p>
          <p class="card-title">{t.sideTitle}</p>
          <p class="card-text">{t.sideText}</p>
          <div class="side-divider" aria-hidden="true"></div>
          <ul class="side-list">
            {t.sideList.map((s) => <li><span>{s.k}</span><span>{s.v}</span></li>)}
          </ul>
          <a class="text-link" href="#work">{t.viewProject}</a>
        </div>
      </div>
      <div class="side-note">
        <span class="dot" aria-hidden="true"></span>
        <span>{t.sideNote}</span>
      </div>
    </div>
  </div>
</section>
