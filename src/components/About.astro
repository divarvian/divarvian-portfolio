---
import { ui, type Lang } from "../i18n/ui";
interface Props { lang?: Lang }
const lang = Astro.props.lang ?? 'id';
const t = ui[lang].about;
---
<section id="about" class="section wrap about reveal" data-delay="1">
  <div class="about-grid">
    <div class="about-text">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p>{t.p1}</p>
      <p>{t.p2}</p>
      <div class="about-actions">
        <a class="text-link" href="https://github.com/divarvian" target="_blank" rel="noopener noreferrer">{t.links.github}</a>
        <a class="text-link" href="https://linkedin.com/in/divarvian" target="_blank" rel="noopener noreferrer">{t.links.linkedin}</a>
      </div>
    </div>
    <div class="about-card win">
      <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">sekilas.sh — arvian@fedora</span><span class="win-spacer"></span></div>
      <div class="win-body"><p class="card-label">{t.cardLabel}</p><dl>{t.cardItems.map((x) => <div><dt>{x.dt}</dt><dd>{x.href ? <a href={x.href}>{x.dd}</a> : x.dd}</dd></div>)}</dl></div>
    </div>
  </div>
</section>
