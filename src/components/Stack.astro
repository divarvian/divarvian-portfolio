---
import { ui, type Lang } from "../i18n/ui";
interface Props { lang?: Lang }
const lang = Astro.props.lang ?? 'id';
const t = ui[lang].stack;
---
<section id="stack" class="section wrap stack reveal" data-delay="1">
  <div class="stack-intro">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>
    <p>{t.desc}</p>
  </div>
  <div class="stack-grid">
    <div class="stack-card win">
      <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">mobile.sh — arvian@fedora</span><span class="win-spacer"></span></div>
      <div class="win-body"><h3>{t.mobileTitle}</h3><ul>{t.mobileItems.map((x) => <li><span>{x.l}</span><span>{x.r}</span></li>)}</ul><p class="meta-k" style="margin-top:10px">{t.countLabel}</p></div>
    </div>
    <div class="stack-card win">
      <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">system.sh — arvian@fedora</span><span class="win-spacer"></span></div>
      <div class="win-body"><h3>{t.systemTitle}</h3><ul>{t.systemItems.map((x) => <li><span>{x.l}</span><span>{x.r}</span></li>)}</ul><p class="meta-k" style="margin-top:10px">{t.countLabel}</p></div>
    </div>
    <div class="stack-card win">
      <div class="win-bar" aria-hidden="true"><span class="win-dots"><span></span><span></span><span></span></span><span class="win-title">backend.sh — arvian@fedora</span><span class="win-spacer"></span></div>
      <div class="win-body"><h3>{t.backendTitle}</h3><ul>{t.backendItems.map((x) => <li><span>{x.l}</span><span>{x.r}</span></li>)}</ul><p class="meta-k" style="margin-top:10px">{t.countLabel}</p></div>
    </div>
  </div>
</section>
