---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  lang?: 'id' | 'en';
}
const {
  title = "Diva Arviansyah - Mobile Engineer | divarvian.my.id",
  description = "Mobile Engineer, Pendidikan Teknologi Informasi FILKOM Universitas Brawijaya, Raion Community. Kotlin Jetpack Compose dan Flutter, belajar dengan membangun.",
  canonical = "https://divarvian.my.id/",
  ogImage = "/favicon.svg",
  lang = 'id' as 'id' | 'en',
} = Astro.props;
const site = "https://divarvian.my.id";
const canonicalURL = canonical.startsWith("http") ? canonical : new URL(canonical, site).href;
const ogImageURL = ogImage.startsWith("http") ? ogImage : new URL(ogImage, site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {(() => {
      const rawPath = Astro.url.pathname;
      const cleanPath = rawPath.replace(/^\/en(?=\/|$)/, '') || '/';
      const base = site;
      const idHref = base + cleanPath;
      const enHref = base + '/en' + (cleanPath === '/' ? '/' : cleanPath);
      return (
        <>
          <link rel="alternate" hreflang="id" href={idHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={base + '/'} />
        </>
      );
    })()}
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Person",name:"Diva Arviansyah",jobTitle:"Mobile Engineer",url:"https://divarvian.my.id",sameAs:["https://github.com/divarvian","https://linkedin.com/in/divarvian","https://instagram.com/divarvian"],knowsAbout:["Kotlin","Jetpack Compose","Flutter","Dart","Java","C++","Supabase","Fedora Linux"],alumniOf:{ "@type":"CollegeOrUniversity", name:"Universitas Brawijaya", department:"FILKOM - Pendidikan Teknologi Informasi"},memberOf:{ "@type":"Organization", name:"Raion Community"}})} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="divarvian.my.id" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="author" content="Diva Arviansyah" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#C2410C" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14181E" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function(){try{var s=localStorage.getItem('theme');var m=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;var d=s?s==='dark':m;if(d){document.documentElement.classList.add('dark')}document.documentElement.setAttribute('data-theme',d?'dark':'light')}catch(e){}})();
    </script>
    <script is:inline>
      (function(){
        try{
          var LK='lang';
          var stored=null;try{stored=localStorage.getItem(LK);}catch(e){}
          if(stored) return;
          var nav=(navigator.language||'').toLowerCase();
          var prefersEn=nav.indexOf('en')===0;
          var path=location.pathname;
          var isEn=path.indexOf('/en')===0;
          var isRoot=path==='/'||path==='';
          if(prefersEn&&isRoot&&!isEn){
            try{localStorage.setItem(LK,'en');}catch(e){}
            location.replace('/en/'+location.search+location.hash);
          }
        }catch(e){}
      })();
      document.addEventListener('click',function(e){
        var a=e.target&&e.target.closest?e.target.closest('a.lang-switch'):null;
        if(!a) return;
        try{var h=a.getAttribute('href')||'';var L=h.indexOf('/en')===0?'en':'id';localStorage.setItem('lang',L);}catch(err){}
      });
    </script>
    <script is:inline>
      try { if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; } catch (e) {}
      (function () {
        function isReload() {
          try {
            var n = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
            if (n) return n.type === 'reload';
          } catch (e) {}
          try { return sessionStorage.getItem('_reloading') === '1'; } catch (e2) {}
          return false;
        }
        function forceTop() {
          try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {}
          try { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); } catch (e2) { window.scrollTo(0, 0); }
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
        }
        if (location.hash && isReload()) {
          forceTop();
          document.addEventListener('DOMContentLoaded', forceTop);
          window.addEventListener('load', function () { setTimeout(forceTop, 30); setTimeout(forceTop, 180); });
          var t = 0;
          var iv = setInterval(function () { forceTop(); if (++t > 14) clearInterval(iv); }, 60);
        }
        window.addEventListener('pageshow', function (e) { if (e.persisted && location.hash) forceTop(); });
        try {
          window.addEventListener('beforeunload', function () {
            try { if (location.hash) sessionStorage.setItem('_reloading', '1'); else sessionStorage.removeItem('_reloading'); } catch (e) {}
          });
          window.addEventListener('load', function () {
            setTimeout(function () { try { sessionStorage.removeItem('_reloading'); } catch (e) {} }, 900);
          });
        } catch (e3) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Loncat ke konten</a>
    <div class="scroll-indicator" id="scrollIndicator" aria-hidden="true"></div>
    <button class="back-to-top" id="backToTop" type="button" aria-label="Kembali ke atas" title="Kembali ke atas" hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <div class="mouse-glow" id="mouseGlow" aria-hidden="true"></div>
    <div class="mouse-dot" id="mouseDot" aria-hidden="true"></div>
    <slot />
    <div id="cmdPalette" hidden role="dialog" aria-modal="true" aria-label="Command palette">
      <div class="cmd-backdrop" data-cmd-close></div>
      <div class="cmd-panel" role="document">
        <div class="cmd-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="cmdInput" type="text" autocomplete="off" spellcheck="false" placeholder="Ketik untuk cari…" aria-label="Cari" />
          <kbd class="cmd-esc">ESC</kbd>
        </div>
        <div class="cmd-list-wrap">
          <ul id="cmdList" role="listbox" aria-label="Hasil"></ul>
          <p id="cmdEmpty" class="cmd-empty" hidden>Tidak ada hasil</p>
        </div>
        <div class="cmd-foot"><span>↑↓ Navigasi</span><span>↵ Pilih</span><span>ESC Tutup</span><span class="cmd-foot-hint"><kbd>⌘</kbd><kbd>K</kbd> / <kbd>/</kbd></span></div>
      </div>
    </div>
    <script is:inline>
      (function(){
        try{
          if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var glow=document.getElementById('mouseGlow');
          var dot=document.getElementById('mouseDot');
          if(!glow||!dot) return;
          var isCoarse=window.matchMedia('(hover: none), (pointer: coarse)').matches;
          var gx=innerWidth/2,gy=160,dx=gx,dy=gy,tx=gx,ty=gy,show=false,raf=null,hideT=null;
          function loop(){
            gx+=(tx-gx)*0.08; gy+=(ty-gy)*0.08;
            dx+=(tx-dx)*0.35; dy+=(ty-dy)*0.35;
            glow.style.transform='translate3d(calc('+gx+'px - 50%), calc('+gy+'px - 50%), 0)';
            dot.style.transform='translate3d(calc('+dx+'px - 50%), calc('+dy+'px - 50%), 0)';
            if(show) raf=requestAnimationFrame(loop); else raf=null;
          }
          function wake(){ if(hideT){clearTimeout(hideT);hideT=null;} if(!show){show=true;glow.style.opacity='1';dot.style.opacity='1';} if(!raf) raf=requestAnimationFrame(loop); }
          function hide(){ show=false; glow.style.opacity='0'; dot.style.opacity='0'; if(raf){cancelAnimationFrame(raf);raf=null;} }
          function hideSoon(){ if(hideT) clearTimeout(hideT); hideT=setTimeout(hide,340); }
          if(isCoarse){
            addEventListener('touchstart',function(e){ var t=e.touches[0]; if(!t) return; tx=t.clientX; ty=t.clientY; wake(); },{passive:true});
            addEventListener('touchmove',function(e){ var t=e.touches[0]; if(!t) return; tx=t.clientX; ty=t.clientY; wake(); },{passive:true});
            addEventListener('touchend',hideSoon,{passive:true});
            addEventListener('touchcancel',hideSoon,{passive:true});
          } else {
            addEventListener('mousemove',function(e){ tx=e.clientX; ty=e.clientY; wake(); },{passive:true});
            document.addEventListener('mouseleave',hide);
            document.addEventListener('mouseover',function(e){
              var h=e.target&&e.target.closest?e.target.closest('a,button'):null;
              dot.classList.toggle('is-hover',!!h);
            },{passive:true});
          }
        }catch(e){}
        })();
        (function(){
          try{
            var scrollEl=document.getElementById('scrollIndicator');
            var backBtn=document.getElementById('backToTop');
            var toastEl=document.getElementById('toast');
            if(!scrollEl||!backBtn||!toastEl) return;
            var isEn=location.pathname.indexOf('/en')===0;
            var toastMsg=isEn?'Email copied to clipboard':'Email disalin ke clipboard';
            var backLabel=isEn?'Back to top':'Kembali ke atas';
            backBtn.setAttribute('aria-label',backLabel);
            backBtn.setAttribute('title',backLabel);
            window.haptic=function(ms){ try{ if(navigator.vibrate) navigator.vibrate(ms); }catch(e){} };
            function haptic(ms){ return window.haptic(ms); }
            function showToast(msg){ toastEl.textContent=msg; toastEl.removeAttribute('hidden'); setTimeout(function(){ toastEl.setAttribute('hidden',''); },2200); }
            window.toast=showToast;
            var copyBtns=document.querySelectorAll('.copy-btn');
            copyBtns.forEach(function(btn){ btn.addEventListener('click',function(e){ haptic(35); showToast(toastMsg); }); });
            function scrollUpdate(){ var scrolled=window.scrollY; var total=document.documentElement.scrollHeight-window.innerHeight; var progress=scrolled/total; scrollEl.style.transform='scaleX('+progress+')'; backBtn.hidden=scrolled<300; }
            scrollUpdate();
            window.addEventListener('scroll',scrollUpdate,{passive:true});
            backBtn.addEventListener('click',function(){ haptic(10); window.scrollTo({top:0,behavior:'smooth'}); });
            document.querySelectorAll('.mobile-dock a').forEach(function(a){ a.addEventListener('click',function(){ haptic(10); },{passive:true}); });
            var themeBtn=document.getElementById('themeBtn'); if(themeBtn) themeBtn.addEventListener('click',function(){ haptic(12); });
          }catch(e){}
        })();
      (function(){
        var d=document.querySelector('.mobile-dock');
        if(!d) return;
        if(!window.matchMedia('(max-width: 720px)').matches) return;
        if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){ d.classList.add('is-visible'); return; }
        var ticking=false,lastY=window.scrollY;
        function vis(show){ if(show) d.classList.add('is-visible'); else d.classList.remove('is-visible'); }
        function onScroll(){
          if(ticking) return;
          ticking=true;
          requestAnimationFrame(function(){
            var y=window.scrollY;
            var down=y>lastY;
            var show= y>100 && (down || y>220);
            if(y<=10) show=false;
            vis(show);
            lastY=y;
            ticking=false;
          });
        }
        vis(window.scrollY>140);
        window.addEventListener('scroll',onScroll,{passive:true});
        window.addEventListener('resize',function(){ if(!window.matchMedia('(max-width: 720px)').matches) vis(false); },{passive:true});
      })();
    </script>
    <script is:inline>
      (function(){
        var palette=document.getElementById('cmdPalette');
        var input=document.getElementById('cmdInput');
        var list=document.getElementById('cmdList');
        var empty=document.getElementById('cmdEmpty');
        if(!palette||!input||!list) return;
        var isEn=location.pathname.indexOf('/en')===0;
        var p=isEn?'/en':'';
        var _cp=location.pathname;var _cs=location.search;var _ch=location.hash;
        var switchHref=isEn?(_cp.replace(/^\/en(?=\/|$)/,'')||'/')+_cs+_ch:(_cp==='/'?'/en/':'/en'+_cp)+_cs+_ch;
        input.placeholder=isEn?'Search projects, pages…':'Cari project, halaman…';
        var selected=0;
        var filtered=[];
        var items=[
          {title:isEn?'Go to Work':'Buka Project',meta:'#work',href:p+'/#work',kw:'work project portfolio bingo kawal',icon:'▦'},
          {title:isEn?'Go to Stack':'Buka Teknologi',meta:'#stack',href:p+'/#stack',kw:'stack tech teknologi kotlin flutter java supabase fedora',icon:'◇'},
          {title:isEn?'Go to About':'Buka Tentang',meta:'#about',href:p+'/#about',kw:'about tentang raion community',icon:'○'},
          {title:isEn?'Go to Contact':'Buka Kontak',meta:'#contact',href:p+'/#contact',kw:'contact kontak email hubungi',icon:'✉'},
          {title:isEn?'Open Setup':'Buka Setup',meta:'/uses',href:p+'/uses',kw:'uses setup terminal fastfetch fedora tools',icon:'⬢'},
          {title:'BinGo — Raion Intern',meta:'GitHub · Kotlin Compose',href:'https://github.com/divarvian/BinGo-Raion-Internship',kw:'bingo kotlin jetpack compose intern raion',icon:'◆',ext:1},
          {title:'Kawal.Z — Hackjam',meta:'GitHub · Flutter',href:'https://github.com/divarvian/raion-hackjam-13',kw:'kawal.z kawal flutter hackjam',icon:'◆',ext:1},
          {title:isEn?'Kawal.Z Demo':'Demo Kawal.Z',meta:'Instagram',href:'https://www.instagram.com/p/Dc22DFCoKP4/?img_index=2',kw:'demo kawal instagram',icon:'▶',ext:1},
          {title:'GitHub',meta:'github.com/divarvian',href:'https://github.com/divarvian',kw:'github divarvian code',icon:'◈',ext:1},
          {title:isEn?'Send email':'Kirim email',meta:'divarvian@gmail.com',href:'mailto:divarvian@gmail.com',kw:'email mail divarvian gmail',icon:'✉'},
          {title:isEn?'Copy email':'Salin email',meta:'divarvian@gmail.com',action:'copy',kw:'copy salin email',icon:'⎘'},
          {title:isEn?'Switch to Indonesian':'Ganti ke Inggris',meta:isEn?'ID':'EN',href:switchHref,kw:'bahasa language indonesian english ganti switch en id',icon:'◎'},
          {title:isEn?'Toggle theme':'Ganti tema',meta:isEn?'light / dark':'terang / gelap',action:'theme',kw:'theme tema dark light gelap terang',icon:'◐'}
        ];
        function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');}
        function render(q){
          var qq=(q||'').toLowerCase().trim();
          filtered=qq?items.filter(function(it){return (it.title+' '+it.meta+' '+it.kw).toLowerCase().indexOf(qq)!==-1;}):items.slice();
          selected=Math.min(selected,Math.max(0,filtered.length-1));
          if(selected<0) selected=0;
          list.innerHTML=filtered.map(function(it,i){
            var sel=i===selected?'true':'false';
            var kbd=it.ext?'↗':(it.href&&it.href.indexOf('#')!==-1?'↵':'↵');
            return '<li><button class="cmd-item" role="option" tabindex="-1" data-i="'+i+'" aria-selected="'+sel+'" data-href="'+esc(it.href||'')+'" data-action="'+esc(it.action||'')+'" data-ext="'+(it.ext?1:0)+'"><span class="cmd-item-left"><span class="cmd-icon" aria-hidden="true">'+esc(it.icon)+'</span><span class="cmd-title">'+esc(it.title)+'</span></span><span style="display:flex;gap:8px;align-items:center"><span class="cmd-meta">'+esc(it.meta)+'</span><span class="cmd-kbd">'+kbd+'</span></span></button></li>';
          }).join('');
          if(empty) empty.hidden=filtered.length!==0;
          list.querySelectorAll('.cmd-item').forEach(function(btn){
            btn.addEventListener('click',function(){ activate(filtered[parseInt(btn.getAttribute('data-i'),10)]); });
            btn.addEventListener('mousemove',function(){ var idx=parseInt(btn.getAttribute('data-i'),10); if(idx!==selected){ selected=idx; syncSel(); } });
          });
          syncSel();
        }
        function syncSel(){
          list.querySelectorAll('.cmd-item').forEach(function(b,i){ b.setAttribute('aria-selected', i===selected?'true':'false'); });
          var el=list.querySelector('[aria-selected="true"]');
          if(el) el.scrollIntoView({block:'nearest'});
        }
        function isInput(el){ if(!el) return false; var t=el.tagName; return t==='INPUT'||t==='TEXTAREA'||el.isContentEditable; }
        function open(q){
          palette.removeAttribute('hidden');
          document.body.style.overflow='hidden';
          selected=0;
          input.value=q||'';
          render(input.value);
          setTimeout(function(){ input.focus(); input.select(); },10);
        }
        function close(){
          palette.setAttribute('hidden','');
          document.body.style.overflow='';
          input.blur();
        }
        function activate(it){
          if(!it) return;
          if(it.href && it.href.indexOf('/en')===0){ try{ localStorage.setItem('lang', it.href.indexOf('/en')===0 ? 'en' : 'id'); }catch(e){} }
          else if(!isEn && it.href && it.href.indexOf('/')===0){ try{ localStorage.setItem('lang','id'); }catch(e){} }
          close();
          if(it.action==='copy'){
            var txt='divarvian@gmail.com';
            if(navigator.clipboard&&window.isSecureContext){ navigator.clipboard.writeText(txt).catch(function(){}); }
            else{ try{ var ta=document.createElement('textarea');ta.value=txt;ta.style.position='fixed';ta.style.left='-9999px';document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove(); }catch(e){} }
            if(window.haptic) window.haptic(14);
            if(window.toast) window.toast(isEn?'Email copied':'Email disalin');
            return;
          }
          if(it.action==='theme'){
            var b=document.getElementById('themeBtn'); if(b) b.click(); return;
          }
          if(it.href){
            if(it.ext) window.open(it.href,'_blank','noopener');
            else location.href=it.href;
          }
        }
        input.addEventListener('input',function(){ selected=0; render(input.value); });
        input.addEventListener('keydown',function(e){
          if(e.key==='ArrowDown'){ e.preventDefault(); selected=Math.min(filtered.length-1,selected+1); syncSel(); }
          else if(e.key==='ArrowUp'){ e.preventDefault(); selected=Math.max(0,selected-1); syncSel(); }
          else if(e.key==='Enter'){ e.preventDefault(); activate(filtered[selected]); }
          else if(e.key==='Escape'){ e.preventDefault(); close(); }
        });
        document.addEventListener('keydown',function(e){
          var palOpen=!palette.hasAttribute('hidden');
          if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){ e.preventDefault(); if(palOpen) close(); else open(''); return; }
          if(e.key==='Escape'&&palOpen){ e.preventDefault(); close(); return; }
          if(!palOpen&&e.key==='/'&&!isInput(document.activeElement)&&!e.metaKey&&!e.ctrlKey&&!e.altKey){
            e.preventDefault(); open(''); return;
          }
          if(!palOpen&&e.key==='/'){ return; }
        });
        palette.querySelectorAll('[data-cmd-close]').forEach(function(el){ el.addEventListener('click',close); });
        palette.addEventListener('click',function(e){ if(e.target===palette) close(); });
        render('');
      })();
    </script>
    <style is:global>
      :root{
        --paper:#FDFCF8;
        --ink:#14181E;
        --ink-2:#2B323B;
        --muted:#5E5C58;
        --muted-2:#6B6A66;
        --stone:#E8E4DD;
        --stone-2:#D9D3C8;
        --clay:#C2410C;
        --clay-2:#9A3412;
        --radius:14px;
        --radius-sm:10px;
        --max:1120px;
        --content:720px;
      }
      *{box-sizing:border-box}
      html{scroll-behavior:smooth}

      html,body{margin:0;background:var(--paper);color:var(--ink);font-family:"Plus Jakarta Sans",system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;line-height:1.6;transition:background-color .18s, color .18s}
      html.dark{
        --paper:#0F1218;
        --ink:#ECE9E3;
        --ink-2:#D8D5D0;
        --muted:#9AA0A8;
        --muted-2:#8B949E;
        --stone:#1F2937;
        --stone-2:#2A3647;
      }
      html.dark body{background:var(--paper);color:var(--ink)}
      a{color:inherit}
      a:focus-visible,button:focus-visible{outline:2px solid var(--clay);outline-offset:2px}
      .skip{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
      .skip:focus{left:16px;top:16px;width:auto;height:auto;background:var(--ink);color:white;padding:10px 14px;border-radius:999px;z-index:99}
      ::selection{background:var(--stone)}
      @media (prefers-reduced-motion:reduce){*{scroll-behavior:auto !important;transition:none !important}}
      .mouse-glow{position:fixed;top:0;left:0;width:400px;height:400px;background:radial-gradient(circle,rgba(194,65,12,.08) 0%,transparent 70%);pointer-events:none;z-index:1;border-radius:50%;transform:translate3d(-50%,-50%,0);opacity:0;transition:opacity .3s ease}
      .mouse-dot{position:fixed;top:0;left:0;width:10px;height:10px;background:#C2410C;border-radius:50%;pointer-events:none;z-index:2;transform:translate3d(-50%,-50%,0);opacity:0;transition:opacity .3s ease,width .2s ease,height .2s ease,background .2s ease}
      .mouse-dot.is-hover{width:16px;height:16px;background:#9A3412}
      .scroll-indicator{position:fixed;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#C2410C 0%,#9A3412 100%);transform-origin:left;transform:scaleX(0);z-index:99;transition:transform .1s ease}
      .back-to-top{position:fixed;bottom:24px;right:24px;width:48px;height:48px;border-radius:50%;background:var(--ink);color:var(--paper);border:1px solid var(--stone-2);display:grid;place-items:center;cursor:pointer;z-index:10;opacity:0;transform:translateY(20px) scale(0.9);transition:opacity .3s ease,transform .3s ease,background .2s ease;box-shadow:0 4px 14px rgba(20,24,30,.15)}
      .back-to-top:not([hidden]){opacity:1;transform:translateY(0) scale(1)}
      .back-to-top:hover{background:var(--clay);border-color:var(--clay)}
      .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(100px);background:var(--ink);color:var(--paper);border:1px solid var(--stone-2);padding:14px 20px;border-radius:999px;font-size:13px;z-index:100;box-shadow:0 8px 24px rgba(20,24,30,.25);transition:transform .3s cubic-bezier(.22,1,.36,1),opacity .3s ease;opacity:0;pointer-events:none;white-space:nowrap}
      .toast:not([hidden]){opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto}
      #cmdPalette{position:fixed;inset:0;z-index:90;display:grid;place-items:start center;padding:8vh 16px 16px}
      #cmdPalette[hidden]{display:none !important}
      .cmd-backdrop{position:absolute;inset:0;background:rgba(10,14,22,.45);backdrop-filter:blur(8px) saturate(1.05)}
      .cmd-panel{position:relative;width:100%;max-width:560px;background:var(--paper);border:1px solid var(--stone);border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.2);max-height:min(70vh,560px);display:flex;flex-direction:column;animation:cmdIn .18s cubic-bezier(.22,1,.36,1)}
      @keyframes cmdIn{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}
      .cmd-search{display:flex;align-items:center;gap:10px;padding:14px 14px;border-bottom:1px solid var(--stone);color:var(--muted)}
      .cmd-search input{flex:1;border:0;outline:0;background:transparent;color:var(--ink);font-size:14px;font-family:"Plus Jakarta Sans",sans-serif}
      .cmd-search input::placeholder{color:var(--muted);opacity:.7}
      .cmd-esc{font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:.06em;border:1px solid var(--stone-2);padding:4px 6px;border-radius:6px;color:var(--muted);background:white}
      .cmd-list-wrap{overflow:auto;flex:1;min-height:0;scrollbar-width:thin}
      #cmdList{list-style:none;margin:0;padding:8px;display:grid;gap:2px}
      .cmd-item{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border-radius:10px;cursor:pointer;text-decoration:none;color:var(--ink-2);font-size:13.5px;line-height:1.4;border:1px solid transparent;text-align:left;width:100%;background:transparent}
      .cmd-item:hover{background:color-mix(in srgb, var(--stone) 60%, transparent)}
      .cmd-item[aria-selected="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
      .cmd-item[aria-selected="true"] .cmd-meta{color:rgba(255,255,255,.6)}
      .cmd-item-left{display:flex;align-items:center;gap:10px;min-width:0}
      .cmd-icon{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:var(--stone);color:var(--muted);flex:0 0 28px;font-size:12px}
      .cmd-item[aria-selected="true"] .cmd-icon{background:rgba(255,255,255,.15);color:white}
      .cmd-title{font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .cmd-meta{font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:.04em;color:var(--muted);white-space:nowrap}
      .cmd-kbd{font-family:JetBrains Mono,monospace;font-size:10px;color:var(--muted-2);border:1px solid var(--stone-2);padding:2px 6px;border-radius:6px;background:white;flex:0 0 auto}
      .cmd-empty{margin:24px 16px;text-align:center;color:var(--muted);font-size:13px}
      .cmd-foot{display:flex;gap:14px;align-items:center;padding:8px 12px;border-top:1px solid var(--stone);font-size:11px;color:var(--muted-2);font-family:JetBrains Mono,monospace;flex-wrap:wrap}
      .cmd-foot-hint{margin-left:auto;display:flex;gap:4px;align-items:center}
      .cmd-foot-hint kbd{border:1px solid var(--stone-2);padding:1px 5px;border-radius:5px;background:white;font-family:inherit;font-size:10px}
      html.dark .cmd-panel{background:#14181E;border-color:#252F3F}
      html.dark .cmd-search{border-color:#252F3F}
      html.dark .cmd-esc,html.dark .cmd-kbd,html.dark .cmd-foot-hint kbd{background:#1B1F2A;border-color:#2A3647;color:var(--muted)}
      html.dark .cmd-item:hover{background:#1B1F2A}
      html.dark .cmd-item[aria-selected="true"]{background:var(--ink);color:#0F1218}
      html.dark .cmd-item[aria-selected="true"] .cmd-meta{color:rgba(15,18,24,.6)}
      html.dark .cmd-item[aria-selected="true"] .cmd-icon{background:rgba(15,18,24,.12)}
      @media (max-width:480px){.cmd-panel{max-width:100%}#cmdPalette{padding:12px}.cmd-foot{gap:8px}}
      @media print{
        .site-head,.site-foot,.back-to-top,.toast,.mouse-glow,.mouse-dot,.scroll-indicator,.skip,.btn,.hero-badges,.hero-meta,.activity-card,.cta-row{display:none !important}
        body{background:white;color:black}
        .win{border:1px solid #ddd;page-break-inside:avoid}
        .section{padding-block:12px}
        a{color:black;text-decoration:underline}
        @page{margin:2cm}
      }
    </style>
  </body>
</html>
