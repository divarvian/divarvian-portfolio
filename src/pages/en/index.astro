---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Hero from "../../components/Hero.astro";
import Work from "../../components/Work.astro";
import GitHubActivity from "../../components/GitHubActivity.astro";
import Stack from "../../components/Stack.astro";
import About from "../../components/About.astro";
import Contact from "../../components/Contact.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { ui } from "../../i18n/ui";
import "../../styles/site.css";
const lang = 'en' as const;
const t = ui[lang];
const title = 'Diva Arviansyah — Mobile Engineer | divarvian.my.id';
const description = 'Mobile Engineer, Information Technology Education student at FILKOM UB, Raion Community. Kotlin Jetpack Compose and Flutter.';
const canonical = 'https://divarvian.my.id/en/';
---

<Layout lang={lang} title={title} description={description} canonical={canonical}>
  <SiteHeader lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Work lang={lang} />
    <GitHubActivity lang={lang} />
    <Stack lang={lang} />
    <About lang={lang} />
    <Contact lang={lang} />
  </main>
  <SiteFooter lang={lang} />
  <noscript>
    <style>
      .reveal{opacity:1;transform:none}
    </style>
  </noscript>
  <script define:vars={{ copyOk: t.contact.copyOk, copyFail: t.contact.copyFail }}>
    (function(){
      const isEn = location.pathname.indexOf('/en')===0;
      const KEY='theme';
      function apply(dark){
        document.documentElement.classList.toggle('dark',dark);
        document.documentElement.setAttribute('data-theme',dark?'dark':'light');
        try{localStorage.setItem(KEY,dark?'dark':'light')}catch{}
        document.querySelectorAll('#themeBtn').forEach(b=>{
          b.setAttribute('aria-pressed',String(dark));
          b.setAttribute('aria-label',dark?(isEn?'Switch to light':'Ganti ke terang'):(isEn?'Switch to dark':'Ganti ke gelap'));
          b.title=dark?(isEn?'Switch to light':'Ganti ke terang'):(isEn?'Switch to dark':'Ganti ke gelap');
        });
      }
      try{
        const s=localStorage.getItem(KEY);
        if(s) apply(s==='dark');
        else if(window.matchMedia) apply(window.matchMedia('(prefers-color-scheme: dark)').matches);
      }catch{}
      document.getElementById('themeBtn')?.addEventListener('click',()=>apply(!document.documentElement.classList.contains('dark')));
      if(window.matchMedia) window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>{
        try{if(!localStorage.getItem(KEY)) apply(e.matches)}catch{}
      });
    })();
    const btn = document.getElementById('menuBtn');
    const menu = document.getElementById('mobileMenu');
    const copyBtn = document.getElementById('copyEmail');
    const copyStatus = document.getElementById('copyStatus');
    const isEn = location.pathname.indexOf('/en')===0;
    const openLabel = isEn?'Open menu':'Buka menu';
    const closeLabel = isEn?'Close menu':'Tutup menu';
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const open = menu.hasAttribute('hidden');
        if (open) { menu.removeAttribute('hidden'); btn.setAttribute('aria-expanded', 'true'); btn.setAttribute('aria-label', closeLabel); }
        else { menu.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); btn.setAttribute('aria-label', openLabel); }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.hasAttribute('hidden')) {
          menu.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', openLabel);
          btn.focus();
        }
      });
      menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
        menu.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', openLabel);
      }));
      document.addEventListener('click', (e) => {
        const t = e.target;
        if (!menu.hasAttribute('hidden') && !menu.contains(t) && !btn.contains(t)) {
          menu.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', openLabel);
        }
      });
    }

    async function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) {
        try { await navigator.clipboard.writeText(text); return true; } catch {}
      }
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '0';
        ta.style.left = '-9999px';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        ta.setSelectionRange(0, 99999);
        const ok = document.execCommand('copy');
        ta.remove();
        if (ok) return true;
      } catch {}
      return false;
    }
    if (copyBtn && copyStatus) {
      copyBtn.addEventListener('click', async () => {
        const ok = await copyText('divarvian@gmail.com');
        copyStatus.textContent = ok ? copyOk : copyFail;
        if (!ok) { try { window.prompt(isEn?'Copy email:':'Salin alamat email:', 'divarvian@gmail.com'); } catch {} }
        setTimeout(() => copyStatus.textContent = '', 2500);
      });
    }
    document.querySelectorAll('[data-copy-text]').forEach((b) => {
      if (b.id === 'copyEmail') return;
      b.addEventListener('click', async () => {
        const text = b.dataset.copyText || '';
        const copyIcon = b.querySelector('.copy-icon');
        const checkIcon = b.querySelector('.check-icon');
        const ok = await copyText(text);
        if (ok) {
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          setTimeout(() => { copyIcon?.classList.remove('hidden'); checkIcon?.classList.add('hidden'); }, 1600);
        } else {
          try { window.prompt(isEn?'Copy:':'Salin:', text); } catch {}
        }
      });
    });
    if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
      const _t=document.querySelector('.hero-typing');
      if(_t && !_t.hasAttribute('data-typing-done')){
        const _full=_t.getAttribute('data-typing')||_t.textContent||'';
        _t.textContent=''; const _c=document.createElement('span');_c.className='caret';_c.setAttribute('aria-hidden','true');
        const _tx=document.createTextNode(''); _t.appendChild(_tx); _t.appendChild(_c);
        let _i=0;(function _type(){ if(_i<=_full.length){ _tx.textContent=_full.slice(0,_i); _i++; setTimeout(_type,55);} else { _t.textContent=_full; _t.setAttribute('data-typing-done',''); }})();
      }
    }
    const reveals = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      reveals.forEach((el) => io.observe(el));
    } else {
      reveals.forEach((el) => el.classList.add('in'));
    }
    const sections = ['work','stack','about','contact'].map(id => document.getElementById(id)).filter(Boolean);
    const navLinks = Array.from(document.querySelectorAll('.nav-desktop a[href*="#"], .mobile-menu a[href*="#"], .mobile-dock a[href*="#"]'));
    const usesDock = document.querySelector('.mobile-dock a[data-dock="uses"]');
    if(usesDock && !location.pathname.includes('/uses')) usesDock.removeAttribute('aria-current');
    if (sections.length && navLinks.length && 'IntersectionObserver' in window) {
      const spy = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navLinks.forEach(a => {
              const href = a.getAttribute('href') || '';
              const hash = href.includes('#') ? '#' + href.split('#').pop() : '';
              if (hash === '#' + id) a.setAttribute('aria-current', 'true');
              else if (hash.startsWith('#')) a.removeAttribute('aria-current');
            });
            if(usesDock) usesDock.removeAttribute('aria-current');
          }
        });
      }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
      sections.forEach(s => spy.observe(s));
    } else if(usesDock){ usesDock.removeAttribute('aria-current'); }
  </script>
</Layout>
